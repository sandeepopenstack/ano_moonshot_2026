# catalyst_healing_agent/.env
# ==============================
# Environment variables for Vertex AI Agent Engine deployment.
#
# For local run: python main.py reads this via load_dotenv()
# For Agent Engine: set these as Secret Manager secrets or
#   pass via --env_vars flag in the adk deploy command:
#   adk deploy agent_engine ... \
#     --env_vars GOOGLE_CLOUD_PROJECT=poc-z-in2300756,AGENT_MODEL=gemini-2.5-flash

# ── GCP Project ───────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=poc-z-in2300756
GOOGLE_CLOUD_LOCATION=us-central1

# ── Spanner (ReflexAgent domain triage) ───────────────────
SPANNER_INSTANCE=verizon-gnn
SPANNER_DATABASE=syndata

# ── Agent Model ───────────────────────────────────────────
AGENT_MODEL=gemini-2.5-flash

# ── MCP Toolbox ───────────────────────────────────────────
# When deployed to Agent Engine, MCP Toolbox must also be
# deployed (e.g. on Cloud Run) and TOOLBOX_URL updated.
# If not deployed: ReflexAgent falls back to Spanner direct (works fine).
TOOLBOX_URL=http://localhost:5000

# ── Ericsson A2A endpoints──────────────────────────────
# DETECTIVE_AGENT_URL=https://detective.ericsson.example.com
# EXECUTION_URL=https://eic.ericsson.example.com
# Until then: detective_provider.py and execution_provider.py mocks are used.

# ── Pipeline ──────────────────────────────────────────────
MAX_PIPELINE_LOOPS=12 Enable Spanner MCP (ReflexAgent reads entity + edge tables)
SPANNER_INSTANCE=verizon-gnn
SPANNER_DATABASE=syndata

GCP_PROJECT=poc-z-in2300756

# Enable real GNN (replace mock in gnn_inference_provider.py)
GNN_INFERENCE_URL=
# Vertex AI - no API key needed on GCP
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=poc-z-in2300756
GOOGLE_CLOUD_LOCATION=us-central1

# Model
AGENT_MODEL=gemini-2.5-flash

# Pipeline config
BIZ_METADATA_SOURCE=mock
MAX_PIPELINE_LOOPS=12
PIPELINE_COOLDOWN_SECONDS=0

BIZ_METADATA_SOURCE=bigquery
BQ_PROJECT=poc-z-in2300756
BQ_DATASET=syndata
